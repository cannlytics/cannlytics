# ╔══════════════════════════════════════════════════════════════════╗
# ║ Cannlytics — environment variables                               ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# Copy this file to `.env` and fill in only what you use:
#
#     cp .env.example .env            (PowerShell: Copy-Item .env.example .env)
#
# EVERY variable here is optional. `pip install cannlytics` needs none
# of them; each one switches on a feature. Never commit `.env`: it is
# ignored by git and excluded from every distribution (MANIFEST.in).
#
# The library reads the process environment (`os.environ`), so load
# `.env` in your own code, once, at start-up:
#
#     from dotenv import load_dotenv
#     load_dotenv()
#
# Two helpers read a `.env` file themselves, without loading it into the
# environment: `get_google_maps_api_key()` reads `./.env`, and
# `initialize_firebase(env_file=...)` reads the file you name. Nothing
# else does; in particular the AI keys are only read from the environment.
#
# Any key can also be passed explicitly (`COAdoc(api_key=...)`), which
# takes priority over the environment.

# ── Data directories ─────────────────────────────────────────────
# Where datasets, PDFs, and caches are read and written.
# Default: a `.datasets` folder in the current working directory.
CANNLYTICS_DATA_DIR=
# Where `cannlytics.datasets` finds the published results product when a
# caller names none: a product root, or a `cannabis-results-latest.json`.
# CANNLYTICS_RESULTS_DATASET=/data/cannabis-results-2026-09-26

# ── AI providers · extra: [ai] ───────────────────────────────────
# Used by AI-assisted COA parsing (COAdoc) and by embeddings
# (cannlytics.ai). Set only the providers you use, then check them
# with one live request each: `python tools/check_ai_providers.py`.
#
# Anthropic (Claude) — COAdoc's default provider.
ANTHROPIC_API_KEY=
# OpenAI — COA parsing and text embeddings (text-embedding-3-*).
OPENAI_API_KEY=
# Google Gemini — COA parsing and multimodal embeddings
# (gemini-embedding-2: images, PDFs, audio, video).
# COAdoc reads GOOGLE_API_KEY. The Google GenAI SDK accepts either name
# and prefers GOOGLE_API_KEY when both are set, so set just this one.
GOOGLE_API_KEY=
# GEMINI_API_KEY=
# xAI (Grok) — COA parsing.
XAI_API_KEY=

# ── Firebase / Google Cloud · extra: [firebase] ──────────────────
# Absolute path to a service-account JSON key. Needed for Firestore,
# Storage, Auth, Secret Manager, and `cannlytics.auth`. Leave unset on
# Google Cloud (Cloud Run, GCE), where credentials are ambient.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Geocoding and population data · extra: [utils] ───────────────
# Google Maps Platform key, for `cannlytics.data.gis` geocoding.
GOOGLE_MAPS_API_KEY=
# Federal Reserve Economic Data key, for `get_state_data` and
# `get_state_population`; read by the `fredapi` library when no key is
# passed. Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── QR scanning (qrustie) ────────────────────────────────────────
# Absolute path to the `qrustie` binary, which reads the QR code on a
# COA to recover its lab-portal URL. If unset, the absolute directories
# on PATH are searched, then the Python decoder ([qr] extra) is used.
QRUSTIE_PATH=
# Set to 1 to also search build-tree paths under the current working
# directory (qrustie/target/release/...) and relative PATH entries.
# Off by default: running a binary found in whatever folder you happen
# to be in is a way to execute someone else's code.
CANNLYTICS_QRUSTIE_ALLOW_CWD=

# ── Metrc ────────────────────────────────────────────────────────
# The library never reads these: the Metrc client takes its keys as
# arguments (`metrc.authorize(vendor_api_key, user_api_key, ...)`).
# The names are a convention for your own scripts.
METRC_VENDOR_API_KEY=
METRC_USER_API_KEY=
METRC_LICENSE_NUMBER=
METRC_STATE=
